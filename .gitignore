# ---- built and generated: recreated by the build
site/public/
site/local/
site/cache/
site/.wrangler/
corpus/library/perseus/
__pycache__/
*.pyc

# ---- never committed: texts that may not be published
corpus/library/private/
# raw files waiting to be imported and drafts being checked (include copyrighted translations)
corpus/catalog/0_inbox/
corpus/catalog/1_checkstage/

# ---- downloaded material: the Perseus XML and the dictionary sources (re-downloadable, over 700 MB)
corpus/dictionary/

# ---- work-in-progress product
assets/work

# ---- large originals and licensed files
assets/images/JMW Turner*
assets/images/Turner Beacon Light.png
assets/fonts/PPEditorialNew-*

# ---- local tool settings
.claude/
